# Set these in the process environment or Railway Variables.
APP_PASSWORD=
DATA_PATH=/data
ASPNETCORE_URLS=http://0.0.0.0:8080
# Explicit opt-in; simply adding a key does not enable AI.
ANALYSIS_MODE=simulation
OPENAI_MODEL=gpt-5.6-terra
OPENAI_API_KEY=
# Optional bounded higher-resolution comparison for evaluation only.
ANALYSIS_COMPARE_SOURCE=false
